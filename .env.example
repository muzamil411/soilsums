# Copy to .env.local and fill in. Every value is optional — the site builds and
# runs with none of them set.

# Public base URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://soilsums.com

# Google AdSense publisher ID, format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=

# Master switch for ads. Ads render ONLY when this is exactly "true" AND a
# publisher ID is set. While false, no ad markup and no reserved space is
# emitted at all, so the site has no empty gaps during AdSense review.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Google Analytics 4 measurement ID, format: G-XXXXXXXXXX. Leave blank to
# disable analytics entirely.
NEXT_PUBLIC_GA4_ID=
